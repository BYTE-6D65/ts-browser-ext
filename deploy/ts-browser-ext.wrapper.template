#!/bin/bash
# Template wrapper for ts-browser-ext native messaging host.
# Copy to your NativeMessagingHosts dir and set TS_EXIT_NODE.
#
# Install:
#   cp ts-browser-ext.wrapper.template ~/.config/chromium/NativeMessagingHosts/ts-browser-ext
#   chmod +x ~/.config/chromium/NativeMessagingHosts/ts-browser-ext
#   cp ts-browser-ext-binary ~/.config/chromium/NativeMessagingHosts/ts-browser-ext.bin

export TS_EXIT_NODE="<YOUR_EXIT_NODE_TAILSCALE_IP>"

# Respawn-proof node registration: tsnet consumes TS_AUTHKEY whenever its
# state is unauthenticated, so the backend registers itself on every launch
# instead of waiting on rotating interactive login URLs.
# Use a REUSABLE, NON-ephemeral key (ephemeral nodes get reaped when the
# browser closes). Leave empty once registered (empty == unset for tsnet).
TS_AUTHKEY=""
export TS_AUTHKEY

exec "$(dirname "$0")/ts-browser-ext.bin" "$@" 2>>/tmp/ts-browser-ext.log
